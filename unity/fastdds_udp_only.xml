<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!--
    The Orin occasionally retains stale Fast DDS shared-memory segments after
    camera/ROS processes are restarted.  They produce repeated CDR
    "sequence size exceeds remaining buffer" errors.  These dashboard topics
    are small enough that loopback UDP is both reliable and lower risk.
  -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>uav_dashboard_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="uav_dashboard_udp_only" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>uav_dashboard_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
